# MySQL (same database as auth; ML predictions stored in table `predictions`)
MYSQL_HOST=127.0.0.1
# API port. Use 5001 if another local application already uses 5000.
# PORT=5000
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DB=agrosense_auth
# Optional alias:
# MYSQL_DATABASE=agrosense_auth

# Cloudinary — browser upload reads these if VITE_* are unset (see GET /config/cloudinary).
# https://cloudinary.com/console — Cloud name must not be MYSQL_USER (e.g. not "root").
CLOUDINARY_CLOUD_NAME=
# Unsigned upload preset name (Settings → Upload → Upload presets). Required for browser upload.
CLOUDINARY_UPLOAD_PRESET=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Hugging Face — https://huggingface.co/settings/tokens
# Fine-grained token: enable "Make calls to Inference Providers", or router returns HTTP 403.
# Supported names (first non-empty wins): HF_API_KEY, HUGGINGFACEHUB_API_TOKEN, HF_TOKEN
HF_API_KEY=
# Plant disease model (change if needed)
HF_MODEL_ID=linkanjarad/mobilenet_v2_rai_CropDisease
# Optional: default is the Hub router (legacy api-inference.huggingface.co returns HTTP 410).
# HF_INFERENCE_MODELS_BASE=https://router.huggingface.co/hf-inference/models

# Groq — https://console.groq.com/keys — PRIMARY AI provider for this app (vision + text JSON,
# tried first for classification, insights, prognosis, and chat). Server-side only; never put this
# in the frontend .env / VITE_* vars.
GROQ_API_KEY=
# Groq retires models over time (see GET /health/groq -> models_preview for what's live on your key).
# Defaults below are current as of this app's last update; override if Groq decommissions them.
# GROQ_TEXT_MODEL=openai/gpt-oss-120b
# GROQ_TEXT_MODEL_FALLBACKS=openai/gpt-oss-20b,groq/compound
# GROQ_VISION_MODEL=qwen/qwen3.8-27b
# GROQ_VISION_MODEL_FALLBACKS=qwen/qwen3.6-27b

# Google Gemini — https://aistudio.google.com/apikey — OPTIONAL secondary provider, only used when
# Groq is not configured or fails. Used for insights; also used as vision fallback when Hugging Face
# classification fails.
GEMINI_API_KEY=
# Set a real Gemini id you have access to (check GET /health/gemini -> models_preview for your key).
GEMINI_MODEL=gemini-2.5-flash
# Optional: comma-separated backup ids.
# GEMINI_MODEL_FALLBACKS=gemini-2.0-flash
# Optional REST endpoint if required by your network / proxy.
# GEMINI_API_ENDPOINT=https://generativelanguage.googleapis.com
